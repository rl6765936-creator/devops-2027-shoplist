# שלב 1: בנייה (המטבח) - Node מריץ את build.js
FROM node:24-alpine AS build
WORKDIR /app
COPY build.js index.html app.js style.css ./
RUN node build.js

# שלב 2: הרצה (מגש ההגשה) - רק Nginx והתוצאה של הבנייה
FROM nginx:1.30-alpine
COPY --from=build /app/dist/ /usr/share/nginx/html/
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
